{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Angular CLI",
      "program": "${workspaceFolder}/node_modules/@angular/cli/bin/ng",
      "args": ["serve", "--host=0.0.0.0", "--disable-host-check"],
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome with Angular",
      "url": "http://prueba.local:4200",  // Cambia aquí
      "webRoot": "${workspaceFolder}"
    }
  ]
}
